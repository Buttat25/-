word_1 = input("Введите первое слово: ")
word_2 = input("Введите второе слово: ")

list_1 = list(word_1)
list_2 = list(word_2)

for letter in list_1:
  
    if letter in list_2:
        list_2.remove(letter) 

if len(list_2) == 0 and len(word_1) == len(word_2):
    print("Да, это анаграммы!")
else:
    print("Нет, это не анаграммы.")
